# Telegram API credentials from https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash_here

# Userbot session string (generated using GramJS / Pyrogram)
STRING_SESSION=1BJWapW...your_string_session_here

# Source chat/bot to listen to (e.g. Telegram User ID or Bot Username/ID)
SOURCE_CHAT_ID=123456789

# Target group ID where media should be forwarded (e.g. -100xxxxxxxxxx)
TARGET_GROUP_ID=-100xxxxxxxxxx
