generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int        @id @default(autoincrement())
  telegramId          BigInt     @unique
  randomName          String     @unique
  isBanned            Boolean    @default(false)
  hasBlockedBot       Boolean    @default(false)
  bannedAt            DateTime?
  bannedOnKeyId       Int?
  bannedOnKey         AccessKey? @relation("BannedOnKey", fields: [bannedOnKeyId], references: [id])
  registeredWithKeyId Int?
  registeredWithKey   AccessKey? @relation("RegisteredWithKey", fields: [registeredWithKeyId], references: [id])
  mediaSentCount      Int        @default(0)
  lastMediaSentAt     DateTime?
  createdAt           DateTime   @default(now())
}

model AccessKey {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  usageCount      Int      @default(0)
  createdAt       DateTime @default(now())
  isRevoked       Boolean  @default(false)
  bannedUsers     User[]   @relation("BannedOnKey")
  registeredUsers User[]   @relation("RegisteredWithKey")
}
